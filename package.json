{
  "name": "be-the-bee",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Digital adaptation of the 2-player hex strategy board game \"Be the Bee\".",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:engine": "tsc --noEmit --project tsconfig.engine.json",
    "verify:click": "node scripts/verify-click.mjs",
    "sim": "vitest run --config vite.sim.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.0",
    "qrcode": "^1.5.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@types/three": "^0.184.1",
    "three": "^0.184.0"
  }
}
